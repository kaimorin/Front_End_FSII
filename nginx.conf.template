server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    # ── Cabeceras de seguridad ─────────────────────────────────────────
    add_header X-Content-Type-Options    "nosniff"                      always;
    add_header X-Frame-Options           "DENY"                         always;
    add_header X-XSS-Protection          "1; mode=block"                always;
    add_header Referrer-Policy           "no-referrer"                  always;
    add_header Permissions-Policy        "geolocation=(), microphone=(), camera=()" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header Content-Security-Policy
      "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' ${BACKEND_URL}; frame-ancestors 'none';"
      always;

    # ── SPA fallback ───────────────────────────────────────────────────
    location / {
        try_files $uri /index.html;
    }

    # ── Proxy al backend ───────────────────────────────────────────────
    location /api/ {
        proxy_pass         ${BACKEND_URL};
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
        # No exponer la versión del back
        proxy_hide_header  Server;
        proxy_hide_header  X-Powered-By;
    }

    # ── Deshabilitar listado de directorios ───────────────────────────
    autoindex off;

    # ── Caché ──────────────────────────────────────────────────────────
    # `expires` no usa add_header, así que estos bloques conservan las cabeceras de seguridad.
    # Los archivos de /assets/ llevan hash en el nombre: se pueden cachear un año.
    location /assets/ {
        expires 1y;
        try_files $uri =404;
    }

    # index.html nunca se cachea para que un deploy nuevo se vea de inmediato.
    location = /index.html {
        expires -1;
    }
}
